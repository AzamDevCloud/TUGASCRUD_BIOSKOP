# Copy this file to .env.local and fill in values from Aiven.
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=replace_with_your_rotated_password
DB_NAME=defaultdb

# Paste the contents of the Aiven CA certificate here as a single-quoted multiline value.
# Keep the BEGIN/END CERTIFICATE lines. See README.md for details.
DB_SSL_CA="-----BEGIN CERTIFICATE-----
PASTE_AIVEN_CA_CERTIFICATE_CONTENT_HERE
-----END CERTIFICATE-----"
